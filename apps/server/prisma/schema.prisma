generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model Profile {
  id                String            @id @db.Uuid
  displayName       String            @map("display_name") @db.VarChar(80)
  avatarUrl         String?           @map("avatar_url")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships       WorkspaceMember[]
  createdWorkspaces Workspace[]       @relation("WorkspaceCreator")

  @@map("profiles")
}

model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(80)
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   Profile           @relation("WorkspaceCreator", fields: [createdById], references: [id])
  members     WorkspaceMember[]

  @@index([createdById])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}
