NODE_ENV=development
PORT=3000

# Runtime connection. Use the Supabase Session Pooler or a direct connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Prisma CLI connection for migrations. Prefer the direct connection URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Comma-separated web origins. Native apps do not use browser CORS.
CORS_ORIGINS=http://localhost:5173
